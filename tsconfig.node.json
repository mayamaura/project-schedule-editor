{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/domain/**/*",
    "tests/domain/**/*",
    "tests/main/**/*",
    "tests/lint/**/*",
    "tests/unit/**/*",
    "electron.vite.config.ts",
    "vite.viewer.config.ts",
    "vitest.config.mts",
    "playwright.config.ts"
  ]
}
